# Auto detect text files and normalize line endings
* text=auto eol=lf

# Swift source
*.swift text diff=swift

# Markdown
*.md text

# YAML / JSON
*.yml text
*.yaml text
*.json text

# Shell scripts must keep LF
*.sh text eol=lf eof=lf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.dmg binary
*.zip binary
*.xcodeproj/ binary merge=union
*.xcworkspace/ binary merge=union