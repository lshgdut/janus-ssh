root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.swift]
indent_size = 4
max_line_length = 120

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 80

[*.yml]
indent_size = 2

[*.json]
indent_size = 2

[*.{yaml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab